{
  "rules": {
    "ptg_game_events_v1": {
      "active": {
        ".read": true,
        ".write": false
      },
      "history": {
        ".read": false,
        ".write": false
      }
    },
    "ptg_bug_reports_v1": {
      ".read": false,
      ".write": false,
      ".indexOn": ["createdAt", "reporterKey"]
    },
    "players_s1": {
      ".read": true,
      "$playerId": {
        ".read": true,
        ".write": true
      }
    },
    "players_s2": {
      ".read": true,
      "$playerId": {
        ".read": true,
        ".write": true
      }
    },
    "players_s3": {
      ".read": true,
      "$playerId": {
        ".read": true,
        ".write": true
      }
    },
    "players_s4": {
      ".read": true,
      "$playerId": {
        ".read": true,
        ".write": true
      }
    },
    "players_s5": {
      ".read": true,
      "$playerId": {
        ".read": true,
        ".write": true
      }
    },
    "referrals_v1": {
      ".read": true,
      ".write": true,
      "$season": {
        ".read": true,
        ".write": true,
        "elite_inviters": {
          ".read": true,
          ".write": false
        },
        "summary": {
          ".indexOn": ["pendingReward", "earnedTotal", "lastRewardAt"]
        },
        "reward_events": {
          ".indexOn": ["ts", "kind", "spenderId"]
        },
        "claim_history": {
          "$userId": {
            ".indexOn": ["ts"]
          }
        }
      }
    }
  }
}
